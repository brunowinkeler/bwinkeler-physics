---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="page-shell">
    <header class="page-header">
      <p class="eyebrow">404</p>
      <h1>This experiment does not exist.</h1>
      <p>
        The requested simulation or theory page could not be found. Return to
        the catalog to choose an available laboratory.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="/">Return to the catalog</a>
      </div>
    </header>
  </div>
</BaseLayout>
