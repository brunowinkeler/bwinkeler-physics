---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

import { getSimulationControls } from "../data/controls";
import type { SimulationDefinition } from "../data/simulations";

import SimulationControls from "./SimulationControls.astro";

interface Props {
  simulation: SimulationDefinition;
}

const { simulation } = Astro.props;
const runtimeScript = simulation.runtimeScript;
const controls = getSimulationControls(simulation.id);
const runtimeAvailable = Boolean(
  runtimeScript &&
  existsSync(
    resolve(process.cwd(), "public", runtimeScript.replace(/^\//, "")),
  ),
);
---

<section class="lab-frame" aria-labelledby="runtime-heading">
  {
    runtimeAvailable && runtimeScript ? (
      <div
        class:list={["simulation-runtime", controls && "has-controls"]}
        data-simulation-runtime
        data-simulation-id={simulation.id}
        data-runtime-script={runtimeScript}
        data-minimum-width={simulation.minimumViewport.width}
        data-minimum-height={simulation.minimumViewport.height}
      >
        <h2 id="runtime-heading" class="visually-hidden">
          Interactive simulation
        </h2>
        <div class="simulation-runtime__toolbar">
          <p>{simulation.shortcuts}</p>
          <div class="simulation-runtime__toolbar-actions">
            {controls && (
              <button
                class="simulation-runtime__fullscreen"
                type="button"
                data-controls-toggle
                aria-expanded="true"
                aria-controls="simulation-controls"
              >
                <span data-controls-label>Hide controls</span>
              </button>
            )}
            <button
              class="simulation-runtime__fullscreen"
              type="button"
              data-fullscreen-toggle
              aria-label="Enter full screen"
              hidden
            >
              <span data-fullscreen-icon aria-hidden="true">
                ⛶
              </span>
              <span data-fullscreen-label>Full screen</span>
            </button>
          </div>
        </div>
        <div class="simulation-runtime__layout">
          <div class="simulation-runtime__viewport">
            <div
              class="simulation-runtime__status"
              data-runtime-status
              role="status"
            >
              <span class="simulation-runtime__spinner" aria-hidden="true" />
              <span data-runtime-status-text>
                Preparing WebAssembly runtime…
              </span>
            </div>
            <canvas
              id="canvas"
              class="simulation-runtime__canvas"
              width="1280"
              height="720"
              tabindex="0"
              aria-label={`${simulation.title} interactive simulation canvas`}
            >
              Your browser does not support the canvas required by this
              simulation.
            </canvas>
            <noscript>
              <p class="notice">
                JavaScript and WebAssembly are required to run the interactive
                simulation. The theory page remains available without them.
              </p>
            </noscript>
          </div>
          {controls && (
            <SimulationControls
              definition={controls}
              simulationTitle={simulation.title}
              panelId="simulation-controls"
            />
          )}
        </div>
      </div>
    ) : (
      <div class="lab-placeholder">
        <div class="lab-placeholder__content">
          <span class="lab-placeholder__icon" aria-hidden="true">
            θ
          </span>
          <h2 id="runtime-heading">WebAssembly runtime is not built yet</h2>
          <p>
            The site and theory can run without generated binaries. Build the
            pinned C++ sources with the Emscripten workflow to place this lab's
            JavaScript and WebAssembly artifacts here.
          </p>
        </div>
      </div>
    )
  }
</section>

<script>
  import { getSimulationControls } from "../data/controls";
  import {
    createSimulationBridge,
    supportsDomControls,
    type PhysicsLabModule,
  } from "../scripts/simulation-bridge";
  import {
    attachSimulationControls,
    type SimulationControlsHandle,
  } from "../scripts/simulation-controls";

  interface EmscriptenModuleConfig extends PhysicsLabModule {
    canvas: HTMLCanvasElement;
    setStatus: (message: string) => void;
    monitorRunDependencies: (remaining: number) => void;
    onRuntimeInitialized: () => void;
    onAbort: (reason: unknown) => void;
    printErr: (message: unknown) => void;
    _physicsLabResizeCanvas?: (width: number, height: number) => void;
  }

  const root = document.querySelector<HTMLElement>("[data-simulation-runtime]");
  const canvas = root?.querySelector<HTMLCanvasElement>("#canvas");
  const status = root?.querySelector<HTMLElement>("[data-runtime-status]");
  const statusText = root?.querySelector<HTMLElement>(
    "[data-runtime-status-text]",
  );
  const fullscreenButton = root?.querySelector<HTMLButtonElement>(
    "[data-fullscreen-toggle]",
  );
  const fullscreenIcon = root?.querySelector<HTMLElement>(
    "[data-fullscreen-icon]",
  );
  const fullscreenLabel = root?.querySelector<HTMLElement>(
    "[data-fullscreen-label]",
  );
  const runtimeScript = root?.dataset.runtimeScript;

  if (
    root &&
    canvas &&
    status &&
    statusText &&
    fullscreenButton &&
    fullscreenIcon &&
    fullscreenLabel &&
    runtimeScript
  ) {
    const runtimeRoot = root;
    const runtimeCanvas = canvas;
    const runtimeStatus = status;
    const runtimeStatusText = statusText;
    const runtimeFullscreenButton = fullscreenButton;
    const runtimeFullscreenIcon = fullscreenIcon;
    const runtimeFullscreenLabel = fullscreenLabel;
    const runtimeScriptUrl = runtimeScript;
    const minimumWidth = Number(runtimeRoot.dataset.minimumWidth);
    const minimumHeight = Number(runtimeRoot.dataset.minimumHeight);
    const controlsPanel = runtimeRoot.querySelector<HTMLElement>(
      "[data-simulation-controls]",
    );
    const controlsToggle = runtimeRoot.querySelector<HTMLButtonElement>(
      "[data-controls-toggle]",
    );
    const controlsToggleLabel = runtimeRoot.querySelector<HTMLElement>(
      "[data-controls-label]",
    );
    const controlsDefinition = getSimulationControls(
      runtimeRoot.dataset.simulationId ?? "",
    );
    let runtimeStarted = false;
    let canvasResizeObserver: ResizeObserver | undefined;
    let controlsHandle: SimulationControlsHandle | undefined;

    function attachControls(physicsLab: EmscriptenModuleConfig) {
      if (!controlsPanel || !controlsDefinition) return;

      if (!supportsDomControls(physicsLab)) {
        controlsPanel.hidden = true;
        console.error(
          "The simulation runtime does not export the control bridge.",
        );
        return;
      }

      controlsHandle = attachSimulationControls(
        controlsPanel,
        createSimulationBridge(physicsLab),
        controlsDefinition,
      );
      controlsPanel.hidden = false;
    }

    function toggleControls() {
      if (!controlsToggle || !controlsToggleLabel) return;

      const collapsed = runtimeRoot.classList.toggle("is-controls-collapsed");
      controlsToggle.setAttribute(
        "aria-expanded",
        collapsed ? "false" : "true",
      );
      controlsToggleLabel.textContent = collapsed
        ? "Show controls"
        : "Hide controls";
    }

    function synchronizeCanvasSize() {
      const module = (window as Window & { Module?: EmscriptenModuleConfig })
        .Module;
      module?._physicsLabResizeCanvas?.(
        Math.max(1, Math.round(runtimeCanvas.clientWidth)),
        Math.max(1, Math.round(runtimeCanvas.clientHeight)),
      );
    }

    function handleFullscreenChange() {
      const fullscreen = document.fullscreenElement === runtimeRoot;
      runtimeRoot.classList.toggle("is-fullscreen", fullscreen);
      runtimeFullscreenButton.setAttribute(
        "aria-label",
        fullscreen ? "Exit full screen" : "Enter full screen",
      );
      runtimeFullscreenIcon.textContent = fullscreen ? "×" : "⛶";
      runtimeFullscreenLabel.textContent = fullscreen
        ? "Exit full screen"
        : "Full screen";

      if (runtimeStarted) {
        requestAnimationFrame(() => {
          synchronizeCanvasSize();
          runtimeCanvas.focus({ preventScroll: true });
        });
      } else {
        handleViewportChange();
      }
    }

    async function toggleFullscreen() {
      try {
        if (document.fullscreenElement === runtimeRoot) {
          await document.exitFullscreen();
        } else {
          await runtimeRoot.requestFullscreen();
        }
      } catch (error) {
        console.error("Full screen could not be opened.", error);
        runtimeFullscreenButton.disabled = true;
        runtimeFullscreenButton.title = "Full screen is unavailable";
      }
    }

    function showError(message: string) {
      runtimeStatus.hidden = false;
      runtimeStatus.classList.add("is-error");
      runtimeStatusText.textContent = message;
    }

    function startRuntime() {
      if (runtimeStarted) return;
      runtimeStarted = true;
      window.removeEventListener("resize", handleViewportChange);

      runtimeStatus.classList.remove("is-error");
      runtimeStatusText.textContent = "Preparing WebAssembly runtime…";

      if (typeof WebAssembly !== "object") {
        showError("This browser does not provide WebAssembly support.");
        return;
      }

      if (!document.createElement("canvas").getContext("webgl")) {
        showError(
          "WebGL is unavailable. Check browser graphics settings or use another device.",
        );
        return;
      }

      const moduleConfig: EmscriptenModuleConfig = {
        canvas: runtimeCanvas,
        setStatus(message) {
          if (message) runtimeStatusText.textContent = message;
        },
        monitorRunDependencies(remaining) {
          runtimeStatusText.textContent = remaining
            ? `Loading simulation resources (${remaining} remaining)…`
            : "Starting simulation…";
        },
        onRuntimeInitialized() {
          synchronizeCanvasSize();
          canvasResizeObserver = new ResizeObserver(synchronizeCanvasSize);
          canvasResizeObserver.observe(runtimeCanvas);
          runtimeStatus.hidden = true;
          runtimeCanvas.focus({ preventScroll: true });
          attachControls(moduleConfig);
        },
        onAbort(reason) {
          showError(`The simulation stopped: ${String(reason)}`);
        },
        printErr(message) {
          console.error(message);
        },
      };

      (window as Window & { Module?: EmscriptenModuleConfig }).Module =
        moduleConfig;

      runtimeCanvas.addEventListener("contextmenu", (event) =>
        event.preventDefault(),
      );

      window.addEventListener("error", (event) => {
        if (!String(event.filename).includes("/runtime/")) return;
        showError(
          "The simulation runtime could not be loaded. Please reload or try again later.",
        );
      });

      const loader = document.createElement("script");
      loader.src = runtimeScriptUrl;
      loader.async = true;
      loader.addEventListener("error", () => {
        showError("The simulation runtime could not be downloaded.");
      });
      document.head.append(loader);
    }

    function handleViewportChange() {
      if (
        window.innerWidth >= minimumWidth &&
        window.innerHeight >= minimumHeight
      ) {
        startRuntime();
        return;
      }

      showError(
        `This interactive lab requires a viewport of at least ${minimumWidth} × ${minimumHeight} pixels. Use a larger display or read the theory instead.`,
      );
    }

    window.addEventListener("resize", handleViewportChange);
    window.addEventListener(
      "pagehide",
      () => {
        canvasResizeObserver?.disconnect();
        controlsHandle?.dispose();
      },
      { once: true },
    );
    document.addEventListener("fullscreenchange", handleFullscreenChange);
    runtimeFullscreenButton.addEventListener("click", toggleFullscreen);
    runtimeFullscreenButton.hidden = !document.fullscreenEnabled;
    controlsToggle?.addEventListener("click", toggleControls);
    handleViewportChange();
  }
</script>
