---
import "katex/dist/katex.min.css";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Physics Lab",
  description = "Interactive C++ physics simulations and theory running directly in the browser.",
} = Astro.props;
const pageTitle = title === "Physics Lab" ? title : `${title} | Physics Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11131c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Sidebar pathname={Astro.url.pathname} />
    <main class="site-main" id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
